    },
    {
      "type": "timeseries",
      "title": "Simulated GPUs: used vs quota",
      "description": "requests.example.com/gpu per team (quota 1 each). The node has 1 (make gpu-sim), so a second team's GPU job waits Pending at the scheduler.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 27,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_resourcequota{resource=\"requests.example.com/gpu\", type=\"used\"}",
          "legendFormat": "{{namespace}} used"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_resourcequota{resource=\"requests.example.com/gpu\", type=\"hard\"}",
