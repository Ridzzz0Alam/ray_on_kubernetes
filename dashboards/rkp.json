        }
      }
    },
    {
      "type": "timeseries",
      "title": "Serve replicas",
      "description": "Replicas the Serve autoscaler is running per deployment (min 1, max 3).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (team, application, deployment) (ray_serve_autoscaling_target_replicas)",
          "legendFormat": "{{team}} {{application}}/{{deployment}}"
