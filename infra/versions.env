# Single source of truth for pinned tool / platform versions.
# Rule: pin exact versions; prefer releases at least ~2 weeks old.
# Checked 2026-11-14. Bump deliberately and note it in PLAN.md's Decision log.

# CLI tools (installed by scripts/install-tools.sh into ~/.local/bin)
KIND_VERSION=v0.33.0
KUBECTL_VERSION=v1.37.2
HELM_VERSION=v4.3.1

# Cluster
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5

# Platform
KUBERAY_CHART_VERSION=1.7.2
RAY_VERSION=2.59.0
RAY_IMAGE=rayproject/ray:2.59.0-py312-cpu
PYTHON_VERSION=3.12

# Platform image built from docker/Dockerfile (RAY_IMAGE + docker/requirements.txt)
RKP_IMAGE=rkp-ray:2.59.0-1
